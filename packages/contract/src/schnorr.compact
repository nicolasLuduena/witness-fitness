// Jubjub Schnorr verification. zk-loan polyfill (known-good), verified against
// Compact 0.31.1: the stdlib does NOT ship jubjubSchnorrVerify (compile probe:
// "unbound identifier jubjubSchnorrVerify"). Adapted: adds schnorrVerifyOk
// (non-aborting, Boolean-returning) so verifyAttestation can COUNT valid
// signatures for the 2-of-3 rule instead of aborting on the first bad one.
pragma language_version >= 0.22 && <= 0.23;

module schnorr {
    import CompactStandardLibrary;

    export struct SchnorrSignature {
        announcement: JubjubPoint;
        response: Field;
    }

    struct SchnorrHashInput<#n> {
        ann_x: Field;
        ann_y: Field;
        pk_x: Field;
        pk_y: Field;
        msg: Vector<n, Field>;
    }

    // The witness provides the quotient and remainder of dividing the challenge
    // hash by 2^248, so we can truncate it to fit in Jubjub's scalar field.
    witness getSchnorrReduction(challengeHash: Field): [Field, Uint<248>];

    circuit challenge<#n>(
        msg: Vector<n, Field>,
        announcement: JubjubPoint,
        pk: JubjubPoint
    ): Field {
        return transientHash<SchnorrHashInput<n>>(
            SchnorrHashInput<n> {
                ann_x: jubjubPointX(announcement),
                ann_y: jubjubPointY(announcement),
                pk_x: jubjubPointX(pk),
                pk_y: jubjubPointY(pk),
                msg: msg
            });
    }

    circuit truncateChallenge(cFull: Field): Field {
        const TWO_248: Field =
            452312848583266388373324160190187140051835877600158453279131187530910662656 as Field;
        // cFull == q * 2^248 + r with r : Uint<248>, so r < 2^248 < Jubjub order.
        const [q, cTruncated] = getSchnorrReduction(cFull);
        assert(disclose(q) * TWO_248 + (disclose(cTruncated) as Field) == cFull,
               "Invalid challenge reduction");
        return disclose(cTruncated) as Field;
    }

    export circuit schnorrVerify<#n>(
        msg: Vector<n, Field>,
        signature: SchnorrSignature,
        pk: JubjubPoint
    ): [] {
        assert(schnorrVerifyOk<n>(msg, signature, pk), "Invalid attestation signature");
    }

    export circuit schnorrVerifyOk<#n>(
        msg: Vector<n, Field>,
        signature: SchnorrSignature,
        pk: JubjubPoint
    ): Boolean {
        const c: Field = truncateChallenge(challenge<n>(msg, signature.announcement, pk));
        const lhs: JubjubPoint = ecMulGenerator(signature.response);
        const rhs: JubjubPoint = ecAdd(signature.announcement, ecMul(pk, c));
        return jubjubPointX(lhs) == jubjubPointX(rhs) && jubjubPointY(lhs) == jubjubPointY(rhs);
    }
}
