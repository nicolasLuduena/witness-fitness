// Versioned assertion schema + frozen field encoding (CONTRACT.md §2).
// Field order below is contract law: every notary signature commits to
// encodeAssertion(assertion) as Vector<22, Field>. The notary MUST use the
// compiled pureCircuits.encodeAssertion / pureCircuits.schnorrChallenge,
// never a hand-rolled encoding.
pragma language_version >= 0.22;

module assertion {
    import CompactStandardLibrary;

    // One metric claim. metricId: 1 = distance (m), 2 = moving time (s);
    // value is the raw number of the unit.
    export struct Claim {
        metricId: Uint<8>;
        value: Uint<64>;
    }

    // Versioned, typed assertion — the common interface between the notary
    // signer and the contract. The field order (and thus the challenge hash
    // and every signature) is frozen; see encodeAssertion.
    export struct Assertion {
        version: Uint<8>;           // schema version (1)
        provider: Uint<8>;          // 1 = reclaim-attestor
        claims: Vector<8, Claim>;   // fixed capacity; actual count in claimCount
        claimCount: Uint<8>;
        timestamp: Uint<32>;        // Unix seconds of the API interaction
        nonce: Bytes<32>;           // per-assertion randomness (replay protection)
        reclaimProofHash: Bytes<32>; // hash of the Reclaim proof artifacts (binding)
    }

    // Fixed-22 challenge preimage: the assertion encoding is always 22
    // Fields, so this module's challenge is non-generic (it mirrors
    // SchnorrHashInput in schnorr.compact).
    struct SchnorrHashInput22 {
        ann_x: Field;
        ann_y: Field;
        pk_x: Field;
        pk_y: Field;
        msg: Vector<22, Field>;
    }

    // The frozen 22-field encoding every notary signature commits to —
    // field order is contract law (see packages/contract/README.md for the
    // index map). Never reimplement off-chain: import the compiled
    // pureCircuits.
    export pure circuit encodeAssertion(assertion: Assertion): Vector<22, Field> {
        return [
            assertion.version as Field,
            assertion.provider as Field,
            assertion.claims[0].metricId as Field,
            assertion.claims[0].value as Field,
            assertion.claims[1].metricId as Field,
            assertion.claims[1].value as Field,
            assertion.claims[2].metricId as Field,
            assertion.claims[2].value as Field,
            assertion.claims[3].metricId as Field,
            assertion.claims[3].value as Field,
            assertion.claims[4].metricId as Field,
            assertion.claims[4].value as Field,
            assertion.claims[5].metricId as Field,
            assertion.claims[5].value as Field,
            assertion.claims[6].metricId as Field,
            assertion.claims[6].value as Field,
            assertion.claims[7].metricId as Field,
            assertion.claims[7].value as Field,
            assertion.claimCount as Field,
            assertion.timestamp as Field,
            degradeToTransient(assertion.nonce),
            degradeToTransient(assertion.reclaimProofHash)
        ];
    }

    // Poseidon challenge hash (transientHash) over (ann_x, ann_y, pk_x,
    // pk_y, msg) — the exact hash the notary must sign. Exported as a pure
    // circuit for signing parity with the in-circuit challenge
    // (schnorr.compact).
    export pure circuit schnorrChallenge(
        ann_x: Field,
        ann_y: Field,
        pk_x: Field,
        pk_y: Field,
        msg: Vector<22, Field>
    ): Field {
        return transientHash<SchnorrHashInput22>(
            SchnorrHashInput22 {
                ann_x: ann_x,
                ann_y: ann_y,
                pk_x: pk_x,
                pk_y: pk_y,
                msg: msg
            });
    }
}
