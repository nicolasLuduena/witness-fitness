{
  "name": "@witnessfitness/contract",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./providers": {
      "types": "./dist/providers.d.ts",
      "import": "./dist/providers.js",
      "require": "./dist/providers.js"
    },
    "./wallet": {
      "types": "./dist/wallet.d.ts",
      "import": "./dist/wallet.js",
      "require": "./dist/wallet.js"
    }
  },
  "scripts": {
    "compact": "compact compile +0.31.1 src/stride.compact ./src/managed/stride",
    "compact:no-zk": "compact compile +0.31.1 --skip-zk src/stride.compact ./src/managed/stride",
    "clean": "rm -rf dist .turbo src/managed node_modules",
    "clear": "rm -rf dist src/managed",
    "check": "pnpm compact:no-zk && mkdir -p dist/managed/stride && tsc --project ./tsconfig.build.json && cp -Rf ./src/managed/stride/. ./dist/managed/stride/ && cp ./src/stride.compact ./dist",
    "build": "pnpm compact && mkdir -p dist/managed/stride && tsc --project ./tsconfig.build.json && cp -Rf ./src/managed/stride/. ./dist/managed/stride/ && cp ./src/stride.compact ./dist",
    "deploy": "pnpm build && tsx scripts/deploy.ts",
    "rotate-notaries": "tsx scripts/rotate-notaries.ts",
    "dev": "pnpm compact:no-zk && vitest",
    "test": "pnpm compact:no-zk && vitest run"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-js": "2.5.1",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/ledger-v8": "8.0.3",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/wallet-sdk-dust-wallet": "3.0.0-rc.0",
    "@midnight-ntwrk/wallet-sdk-facade": "3.0.0-rc.0",
    "@midnight-ntwrk/wallet-sdk-hd": "3.0.1",
    "@midnight-ntwrk/wallet-sdk-shielded": "2.1.0-rc.0",
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": "2.1.0-rc.0",
    "@midnight-ntwrk/wallet-sdk-address-format": "3.1.0-rc.0",
    "@scure/bip39": "^2.0.1",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "dotenv": "^17.2.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  }
}
