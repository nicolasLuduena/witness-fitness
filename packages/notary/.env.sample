# Notary Signer instance config — copy to .env (never commit .env).
# Run 3 instances with 3 distinct keys (ports 8101/8102/8103) so the
# contract's 2-of-3 threshold is over three independent signers.
# Generate a key:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# 32-byte hex Jubjub secret scalar (0x prefix optional)
NOTARY_KEY=
# Instance label, e.g. notary-1
NOTARY_ID=notary-1
# HTTP port
PORT=8101
# Self-hosted Reclaim attestor (plain WS locally; TLS is a prod reverse-proxy concern)
ATTESTOR_URL=ws://localhost:8001/ws
# Deployed stride contract address (canonical: packages/contract/deploy-output.json)
CONTRACT_ADDRESS=364a84dd0bc065d7ea25fd45d2072763a1477ee15011e3b5c6bf2c07d04a5ff3
# Devnet endpoints (used by client glue / rotation tooling)
NODE_URL=http://127.0.0.1:9944
INDEXER_URL=http://127.0.0.1:8088/api/v3/graphql
PROOF_SERVER_URL=http://127.0.0.1:6300
# Comma-separated host allowlist (strava + fixture hosts until live Strava fixtures land)
ALLOWED_HOSTS=www.strava.com,api.strava.com,strava.com,api.github.com
