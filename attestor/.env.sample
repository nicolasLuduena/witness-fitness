# Attestor configuration (copy to .env, never commit .env)

# Hex-encoded private key for the attestor (see attestor-core .env.sample for
# the exact format and scheme — verification task #1).
PRIVATE_KEY=

# Attestor network interface and port (WebSocket endpoint /ws).
HOST=0.0.0.0
PORT=8001

# Optional: restrict tunneled hosts to Strava (see attestor-core docs).
# AUTHENTICATION_PUBLIC_KEY=
