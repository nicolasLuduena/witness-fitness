{
  "name": "witnessfitness",
  "version": "0.1.0",
  "private": true,
  "description": "On-chain Strava \u2014 provably-private fitness challenges on Midnight",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev:contract": "pnpm --filter @witnessfitness/contract dev",
    "dev:notary": "pnpm --filter @witnessfitness/notary dev",
    "dev:client": "pnpm --filter @witnessfitness/client dev",
    "dev:attestor": "bash attestor/run.sh",
    "dev:ui": "pnpm --filter ui dev",
    "devnet:up": "bash devnet/up.sh",
    "devnet:down": "bash devnet/down.sh",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format:check": "biome format .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@midnight-ntwrk/ledger-v8": "8.0.3"
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "cbor-extract",
      "classic-level",
      "esbuild",
      "koffi",
      "msgpackr-extract",
      "re2"
    ]
  }
}
